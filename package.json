{
  "name": "irecord-app",
  "id": "uk.ac.ceh.irecord",
  "title": "iRecord App",
  "description": "iRecord mobile application.",
  "version": "6.5.0",
  "homepage": "https://irecord.org.uk",
  "scripts": {
    "prepare": "husky",
    "start": "webpack serve --progress --port 8000",
    "build": "NODE_ENV=production webpack",
    "build:production": "npm run clean && npm run build && npx cap sync && sed -i '' 's/uk.ac.ceh.irecord/uk.ac.ceh.ir/g' ios/App/App/capacitor.config.json && npm run build:resources",
    "build:resources": "mkdir -p resources && cp -R other/designs/android resources && cp -R other/designs/*.png resources && npx cordova-res ios --skip-config --resources resources --copy && npx cordova-res android --skip-config --resources resources --copy",
    "deploy": "cp other/demo.html build/ && URL=$(vercel --prod -t $VERCEL_TOKEN --yes -A ./other/vercel.json ./build) && CLEAN_URL=$(echo $URL | sed -r \"s/https:\\/\\/(.*)$/\\1/g\") && DEMO_URL=$(echo $CLEAN_URL | sed -r \"s/(.*\\-)[a-z0-9]+\\-flumens(\\.vercel\\.app)$/\\1${BITRISE_BUILD_NUMBER}\\2/g\") && envman add --key DEMO_URL --value \"https://$DEMO_URL\"",
    "deploy:production": "bitrise run ci",
    "clean": "rm -rf build resources",
    "check": "npx tsc --noEmit --skipLibCheck && npm run test:eslint",
    "test": "jest --silent --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand --watch test",
    "test:eslint": "eslint src --quiet && echo '\\033[37;42;1m PASS \\033[00m'",
    "test:e2e": "npx playwright test",
    "make:species": "cd src/common/data && tsx make.ts"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "8.0.0",
    "@capacitor-community/sqlite": "8.1.0",
    "@capacitor/android": "8.4.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/camera": "8.2.0",
    "@capacitor/core": "8.4.1",
    "@capacitor/device": "8.0.2",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/geolocation": "8.2.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@flumens/bigu": "0.4.1",
    "@flumens/ionic": "2.0.0-alpha.106",
    "@flumens/models": "0.28.0",
    "@flumens/tailwind": "0.47.0",
    "@flumens/utils": "0.12.0",
    "@hookform/resolvers": "5.4.0",
    "@ionic-native/core": "5.36.0",
    "@ionic/core": "8.8.12",
    "@ionic/react": "8.8.12",
    "@ionic/react-router": "8.8.12",
    "@mapbox/sphericalmercator": "2.0.2",
    "@react-stately/form": "3.3.1",
    "@sentry/browser": "10.62.0",
    "@turf/distance": "7.3.5",
    "axios": "1.18.1",
    "capacitor-blob-writer": "1.1.20",
    "clsx": "2.1.1",
    "core-js": "3.46.0",
    "deep-diff": "1.0.2",
    "dompurify": "3.4.11",
    "drizzle-orm": "0.45.2",
    "i18next": "26.3.4",
    "ionicons": "8.0.13",
    "jeep-sqlite": "2.8.0",
    "json-stable-stringify": "1.3.0",
    "jwt-decode": "4.0.0",
    "leaflet": "1.9.4",
    "lodash.camelcase": "4.3.0",
    "lodash.mapkeys": "4.6.0",
    "lodash.mergewith": "4.6.2",
    "mobx": "6.16.1",
    "mobx-react": "9.2.2",
    "mobx-utils": "6.1.1",
    "mock-geolocation": "1.0.11",
    "proj4": "2.20.9",
    "proj4leaflet": "1.0.2",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-autosuggest": "10.1.0",
    "react-dom": "19.2.7",
    "react-easy-crop": "6.0.2",
    "react-hook-form": "7.80.0",
    "react-i18next": "17.0.8",
    "react-map-gl": "8.1.1",
    "react-router": "5.3.4",
    "react-router-dom": "5.3.4",
    "react-window": "2.2.7",
    "react-window-infinite-loader": "2.0.1",
    "sql.js": "1.12.0",
    "swiper": "14.0.1",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.2.2",
    "wellknown": "0.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-transform-exponentiation-operator": "8.0.1",
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/preset-env": "8.0.2",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@capacitor/cli": "8.4.1",
    "@flumens/eslint-config": "3.0.2",
    "@flumens/prettier-config": "0.4.0",
    "@flumens/webpack-config": "6.2.0",
    "@playwright/test": "^1.61.1",
    "@types/jest": "30.0.0",
    "@types/leaflet": "1.9.21",
    "@types/lodash.camelcase": "4.3.9",
    "@types/lodash.mapkeys": "4.6.9",
    "@types/lodash.mergewith": "4.6.9",
    "@types/mapbox-gl": "3.5.0",
    "@types/node": "26.0.1",
    "@types/proj4": "2.19.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@types/react-window": "2.0.0",
    "@types/react-window-infinite-loader": "2.0.0",
    "babel-jest": "30.4.1",
    "babel-plugin-module-resolver": "5.0.3",
    "babel-plugin-polyfill-corejs3": "1.0.0",
    "copy-webpack-plugin": "14.0.0",
    "cordova-res": "0.15.4",
    "dotenv": "17.4.2",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-transform-stub": "2.0.0",
    "sinon": "14.0.0",
    "tailwindcss": "4.3.2",
    "tslib": "2.8.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vercel": "54.18.5",
    "webpack": "5.108.3",
    "webpack-cli": "7.1.0",
    "webpack-dev-server": "5.2.5"
  },
  "engines": {
    "node": ">=22.18",
    "npm": ">=10"
  },
  "author": {
    "name": "Flumens",
    "email": "enquiries@flumens.io",
    "url": "https://flumens.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NERC-CEH/irecord-app"
  },
  "bugs": {
    "url": "https://github.com/NERC-CEH/irecord-app/issues"
  },
  "licenses": [
    {
      "type": "GNU GPL v3",
      "url": "http://www.gnu.org/licenses/gpl.html"
    }
  ],
  "keywords": [
    "irecord",
    "biological",
    "recording",
    "mobile",
    "app",
    "offline",
    "ukceh",
    "brc"
  ],
  "babel": {
    "assumptions": {
      "privateFieldsAsProperties": true,
      "setPublicClassFields": true
    },
    "presets": [
      "@babel/preset-react",
      "@babel/preset-env",
      "@babel/preset-typescript"
    ],
    "plugins": [
      "@babel/plugin-transform-runtime",
      [
        "babel-plugin-polyfill-corejs3",
        {
          "method": "usage-global",
          "version": "3.46"
        }
      ],
      [
        "module-resolver",
        {
          "root": [
            "./src"
          ],
          "alias": {
            "@flumens$": "./src/common/flumens",
            "common": "./src/common",
            "helpers": "./src/common/helpers",
            "models": "./src/common/models",
            "Components": "./src/common/Components"
          }
        }
      ],
      "@babel/plugin-transform-exponentiation-operator"
    ]
  },
  "prettier": "@flumens/prettier-config",
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(t|j)sx?$": [
        "babel-jest",
        {
          "presets": [
            "@babel/env"
          ]
        }
      ]
    },
    "testRegex": "src.*((\\.|/*.)(test))\\.(t|j)s?$",
    "moduleNameMapper": {
      "^.+.(css|style|less|sass|scss|svg|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
      "ionicons": "jest-transform-stub",
      "ionic-native": "jest-transform-stub",
      "swiper": "jest-transform-stub"
    },
    "moduleDirectories": [
      "node_modules",
      "components",
      "src"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/setupTests.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!@ionic|@stencil|ionicons)"
    ]
  }
}
